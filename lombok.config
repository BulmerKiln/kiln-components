# Lombok for every module (kiln-build adds it as compile-only).
config.stopBubbling = true
# Generated code is marked @lombok.Generated, so JaCoCo, SpotBugs and PMD measure only ours.
lombok.addLombokGeneratedAnnotation = true
# Getters follow the JavaBeans convention (getId(), isActive()), as MapStruct, Jackson and Spring
# expect. @Value makes fields private and final, so there are no setters.
lombok.anyConstructor.addConstructorProperties = false
